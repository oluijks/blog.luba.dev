{
  "name": "blog.luba.dev",
  "type": "module",
  "version": "5.2.0",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "sync": "astro sync",
    "preview": "astro preview",
    "astro:check": "astro check",
    "astro:build": "astro build",
    "astro:pagefind": "pagefind --site dist",
    "astro:cp": "cp -r dist/pagefind public/",
    "build": "pnpm astro:check && pnpm astro:build && pnpm astro:pagefind && pnpm astro:cp",
    "lint": "eslint .",
    "format": "prettier --write .",
