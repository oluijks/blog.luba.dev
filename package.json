    "@tailwindcss/vite": "^4.1.10",
    "@vercel/toolbar": "^0.1.38",
    "astro": "^5.10.0",
    "dayjs": "^1.11.13",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.12.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.10"
  },
